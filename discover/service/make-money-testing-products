        /* Cards pulse 2 times smoothly: 7.5% -> 28.5% (0.75s -> 2.85s of 10s, ~2.1s) */
        @keyframes ahim-pulse-cards {
          0%, 7.5%, 28.5%, 100%         { transform: scale(1); }
          12.75%, 23.25%                { transform: scale(1.07); }
          18%                           { transform: scale(1); }
        }
        /* Logo pulse 2 times smoothly: 39% -> 60% (3.9s -> 6s of 10s) */
        @keyframes ahim-pulse-logo {
          0%, 39%, 60%, 100%            { transform: scale(1); }
          44.25%, 54.75%                { transform: scale(1.1); }
          49.5%                         { transform: scale(1); }
        }
        /* Users pulse 2 times smoothly: 70.5% -> 91.5% (7.05s -> 9.15s of 10s) */
        @keyframes ahim-pulse-users {
          0%, 70.5%, 91.5%, 100%        { transform: scale(1); }
          75.75%, 86.25%                { transform: scale(1.08); }
          81%                           { transform: scale(1); }
        }

        /* Arrow 1 main (Users -> Cards): fill 0% -> 6.5%, hold, fade 28.5% -> 31.5% */
        @keyframes ahim-arrow1 {
          0%       { stroke-dashoffset: 100; opacity: 1; }
          6.5%     { stroke-dashoffset: 0; opacity: 1; }
          28.5%    { stroke-dashoffset: 0; opacity: 1; }
          31.5%    { stroke-dashoffset: 0; opacity: 0; }
          100%     { stroke-dashoffset: 0; opacity: 0; }
        }
        /* Arrow 1 head: fill 6.5% -> 7.5% */
        @keyframes ahim-arrow1-head {
          0%, 6.5% { stroke-dashoffset: 100; opacity: 1; }
          7.5%     { stroke-dashoffset: 0; opacity: 1; }
          28.5%    { stroke-dashoffset: 0; opacity: 1; }
          31.5%    { stroke-dashoffset: 0; opacity: 0; }
          100%     { stroke-dashoffset: 0; opacity: 0; }
        }
        /* Arrow 2 main (Cards -> Logo): fill 31.5% -> 38%, hold, fade 60% -> 63% */
        @keyframes ahim-arrow2 {
          0%, 31.5% { stroke-dashoffset: 100; opacity: 0; }
          31.51%    { opacity: 1; }
          38%       { stroke-dashoffset: 0; opacity: 1; }
          60%       { stroke-dashoffset: 0; opacity: 1; }
          63%       { stroke-dashoffset: 0; opacity: 0; }
          100%      { stroke-dashoffset: 0; opacity: 0; }
        }
        /* Arrow 2 head: fill 38% -> 39% */
        @keyframes ahim-arrow2-head {
          0%, 31.5% { stroke-dashoffset: 100; opacity: 0; }
          31.51%    { opacity: 1; }
          38%       { stroke-dashoffset: 100; opacity: 1; }
          39%       { stroke-dashoffset: 0; opacity: 1; }
          60%       { stroke-dashoffset: 0; opacity: 1; }
          63%       { stroke-dashoffset: 0; opacity: 0; }
          100%      { stroke-dashoffset: 0; opacity: 0; }
        }
        /* Arrow 3 main (Logo -> Users): REVERSE fill 63% -> 69.5%, hold, fade */
        @keyframes ahim-arrow3 {
          0%, 63%   { stroke-dashoffset: -100; opacity: 0; }
          63.01%    { opacity: 1; }
          69.5%     { stroke-dashoffset: 0; opacity: 1; }
          91.5%     { stroke-dashoffset: 0; opacity: 1; }
          94.5%     { stroke-dashoffset: 0; opacity: 0; }
          100%      { stroke-dashoffset: 0; opacity: 0; }
        }
        /* Arrow 3 head: fill 69.5% -> 70.5% */
        @keyframes ahim-arrow3-head {
          0%, 63%   { stroke-dashoffset: 100; opacity: 0; }
          63.01%    { opacity: 1; }
          69.5%     { stroke-dashoffset: 100; opacity: 1; }
          70.5%     { stroke-dashoffset: 0; opacity: 1; }
          91.5%     { stroke-dashoffset: 0; opacity: 1; }
          94.5%     { stroke-dashoffset: 0; opacity: 0; }
          100%      { stroke-dashoffset: 0; opacity: 0; }
        }

        .ahim-users {
          transform-box: fill-box;
          transform-origin: center;
          animation: ahim-pulse-users 8s ease-in-out infinite;
        }
        .ahim-cards {
          transform-box: fill-box;
          transform-origin: center;
          animation: ahim-pulse-cards 8s ease-in-out infinite;
        }
        .ahim-logo {
          transform-box: fill-box;
          transform-origin: center;
          animation: ahim-pulse-logo 8s ease-in-out infinite;
        }
        .ahim-arrow1 {
          stroke: var(--color-core-freecashGreen-500);
          stroke-width: 3;
          stroke-linecap: round;
          fill: none;
          stroke-dasharray: 100;
          stroke-dashoffset: 100;
          animation: ahim-arrow1 8s linear infinite;
        }
        .ahim-arrow1-head {
          stroke: var(--color-core-freecashGreen-500);
          stroke-width: 3;
          stroke-linecap: round;
          fill: none;
          stroke-dasharray: 100;
          stroke-dashoffset: 100;
          animation: ahim-arrow1-head 8s linear infinite;
        }
        .ahim-arrow2 {
          stroke: var(--color-core-freecashGreen-500);
          stroke-width: 3;
          stroke-linecap: round;
          fill: none;
          stroke-dasharray: 100;
          stroke-dashoffset: 100;
          animation: ahim-arrow2 8s linear infinite;
        }
        .ahim-arrow2-head {
          stroke: var(--color-core-freecashGreen-500);
          stroke-width: 3;
          stroke-linecap: round;
          fill: none;
          stroke-dasharray: 100;
          stroke-dashoffset: 100;
          animation: ahim-arrow2-head 8s linear infinite;
        }
        .ahim-arrow3 {
          stroke: var(--color-core-freecashGreen-500);
          stroke-width: 3;
          stroke-linecap: round;
          fill: none;
          stroke-dasharray: 100;
          stroke-dashoffset: -100;
          animation: ahim-arrow3 8s linear infinite;
        }
        .ahim-arrow3-head {
          stroke: var(--color-core-freecashGreen-500);
          stroke-width: 3;
          stroke-linecap: round;
          fill: none;
          stroke-dasharray: 100;
          stroke-dashoffset: 100;
          animation: ahim-arrow3-head 8s linear infinite;
        }
